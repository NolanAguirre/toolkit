#!/bin/sh

# Kill every process using the specified TCP or UDP port.
# Usage: kill-port 3000

if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <port>" >&2
    exit 2
fi

port=$1

if ! printf '%s' "$port" | grep -zq '^[0-9][0-9]*$'; then
    echo "Error: port must be a number." >&2
    exit 2
fi

if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
    echo "Error: port must be between 1 and 65535." >&2
    exit 2
fi

if command -v lsof >/dev/null 2>&1; then
    pids=$(
        {
            lsof -nP -t -iTCP:"$port" 2>/dev/null
            lsof -nP -t -iUDP:"$port" 2>/dev/null
        } | sort -u
    )
elif command -v fuser >/dev/null 2>&1; then
    pids=$(
        {
            fuser "$port"/tcp 2>/dev/null
            fuser "$port"/udp 2>/dev/null
        } | tr ' ' '\n' | sed '/^$/d' | sort -u
    )
else
    echo "Error: this script requires either lsof or fuser." >&2
    exit 1
fi

if [ -z "$pids" ]; then
    echo "No processes found on port $port."
    exit 0
fi

echo "Killing processes on port $port: $pids"

# Intentional word splitting: each PID becomes a kill argument.
# shellcheck disable=SC2086
kill -9 $pids