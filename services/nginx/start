#!/bin/sh
set -e
cd -- "$(dirname "$0")"
case "${PORT:-}" in
    ''|*[!0-9]*)
        echo 'error: PORT must come from the allocated env-dir configuration' >&2
        exit 1
        ;;
esac
if [ "${#PORT}" -gt 5 ] || [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
    echo 'error: PORT must be between 1 and 65535' >&2
    exit 1
fi
case "${HOST:-}" in
    ''|*[!a-zA-Z0-9.-]*)
        echo 'error: HOST must be an IPv4 address or hostname' >&2
        exit 1
        ;;
esac
mkdir -p .runtime/body .runtime/proxy
pending=$(mktemp .runtime/.nginx.XXXXXX)
trap 'rm -f -- "$pending"' 0
trap 'exit 1' HUP INT TERM
sed -e "s/__PORT__/$PORT/g" -e "s/__HOST__/$HOST/g" nginx.conf > "$pending"
mv -- "$pending" .runtime/nginx.conf
exec nginx -p "$(pwd -P)/" -c .runtime/nginx.conf -g 'daemon off;'
