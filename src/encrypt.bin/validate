#!/bin/sh

: "${STATE_PATH:=${HOME:?HOME is not set}/.s6craft-tools}"
: "${GSTATE_PATH:=/var/lib/s6craft-tools}"
export STATE_PATH GSTATE_PATH
set -e
: "${STATE_PATH:?STATE_PATH is not set}"
export STATE_DIR="$STATE_PATH/encrypt"
if [ ! -f "$STATE_DIR/identity" ]; then
    echo "error: encrypt is not initialized; run toolkit setup encrypt" >&2
    exit 1
fi
command -v age >/dev/null
command -v age-keygen >/dev/null
# Encryption operations must never recursively record history.
export TOOLKIT_HIST_LOCK=1
exec "$@"
