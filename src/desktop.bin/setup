#!/bin/sh
##<help>
## setup - Initialize desktop workspace configuration without replacing existing entries.
## Usage: toolkit setup desktop
##</help>
set -e
. "$(dirname "$0")/../lib/locking.sh"
: "${UTIL_PATH:?UTIL_PATH is not set}"
umask 077
mkdir -p "$UTIL_PATH/desktop"
file_lock "$UTIL_PATH/desktop/lock"
mkdir -p "$UTIL_PATH/desktop/workspaces" "$UTIL_PATH/desktop/history"
echo 'desktop initialized'
