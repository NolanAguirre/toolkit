#!/bin/sh
##<help>
## deploy - Upload prepared service artifacts to their generated bin/deploy commands.
## Usage: remote deploy <repo> <release-directory> [--to target,...]
## Usage: remote deploy <repo> <service> <release-directory> [--to target,...]
## Package once, then deploy to all targets (or the --to subset) in parallel.
## Output lines are prefixed with the target name; stderr ends with ok/failed <target> per target.
## Service names come from services/<folder>/remote-services when present, otherwise the folder name.
## A repository bundle contains <service>/run and that service's packaged files.
## A single-service directory contains run and its packaged files directly.
## Each run must be executable and keep the service in the foreground.
## Deploy as the service owner, atomically switch current, retain four releases and restart with s6.
## Record archive SHA-256 and Git provenance beside the service run file.
## A service artifact may include .toolkit-commit containing its full build commit.
## Otherwise record the registered checkout's HEAD at deploy time, not a proven build commit.
## Load services/<folder>/env-dir/production first; use env-dir/default for missing keys.
## Keep env files out of code artifacts; deployment transfers a private environment snapshot.
## WRITE_DIR defaults to the service data directory; a custom directory must belong to its runner.
##</help>
set -e
. "$REMOTE_BIN/../lib/remote.sh"
if [ "$#" -eq 3 ]; then
    directory=$(CDPATH= cd -- "$3" && pwd -P)
else
    directory=$(CDPATH= cd -- "$2" && pwd -P)
fi
upload=$(mktemp -d "$REMOTE_STATE/.deploy.XXXXXX")
trap 'rm -rf -- "$upload"' 0
trap 'exit 1' HUP INT TERM
repo_path=$(cat "$STATE_PATH/bootstrap/repos/$REMOTE_REPO/path")
checkout_commit=unknown
checkout_dirty=unknown
if command -v git >/dev/null 2>&1 && checkout_commit=$(git -C "$repo_path" rev-parse --verify HEAD 2>/dev/null); then
    checkout_changes=$(git -C "$repo_path" status --porcelain --untracked-files=normal) || remote_error 'cannot inspect checkout changes'
    checkout_dirty=false
    if [ -n "$checkout_changes" ]; then
        checkout_dirty=true
    fi
else
    checkout_commit=unknown
fi
# Package every artifact before SSH; malformed bundles never partly deploy.
while IFS= read -r entry; do
    service=${entry%:*}
    source="$directory/$service"
    if [ "$#" -eq 3 ]; then
        source=$directory
    fi
    [ -d "$source" ] && [ ! -L "$source" ] || remote_error "missing service artifact directory: $source"
    [ -f "$source/run" ] && [ -x "$source/run" ] || remote_error "service artifact needs executable run: $source/run"
    special=$(find "$source" ! -type f ! -type d -print)
    [ -z "$special" ] || remote_error 'release may contain only regular files and directories'
    env_source=$(cat "$REMOTE_SOURCES/$service")
    env_source="$env_source/env-dir"
    environment="$upload/$service.env"
    mkdir "$environment"
    # Production wins, including empty values; defaults fill only missing keys.
    if [ -e "$env_source" ] || [ -L "$env_source" ]; then
        [ -d "$env_source" ] && [ ! -L "$env_source" ] || remote_error "expected a real env-dir: $env_source"
        remote_copy_env "$env_source/production" "$environment"
        remote_copy_env "$env_source/default" "$environment"
    fi
    # A multi-process source may assign PORT from a different key, or have no listener.
    if [ "${entry##*:}" = - ]; then
        : > "$environment/PORT"
    else
        printf '%s\n' "${entry##*:}" > "$environment/PORT"
    fi
    printf 'production\n' > "$environment/ENV_USER"
    commit=$checkout_commit
    commit_source=checkout-at-deploy
    dirty=$checkout_dirty
    if [ -f "$source/.toolkit-commit" ]; then
        commit=$(cat "$source/.toolkit-commit")
        case "$commit" in
            ''|*[!0-9a-f]*)
                remote_error '.toolkit-commit must contain a full lowercase Git commit hash'
                ;;
        esac
        [ "${#commit}" -eq 40 ] || [ "${#commit}" -eq 64 ] || remote_error '.toolkit-commit must contain a full Git commit hash'
        commit_source=artifact
        dirty=unknown
    fi
    tar --format=ustar --mode='u+rwX,go+rX,go-w,a-s' -czf "$upload/$service.tar.gz" -C "$source" .
    archive_hash=$(sha256sum "$upload/$service.tar.gz")
    archive_hash=${archive_hash%% *}
    printf 'commit\t%s\ncommit_source\t%s\ndirty\t%s\narchive_sha256\t%s\n' \
        "$commit" "$commit_source" "$dirty" "$archive_hash" > "$upload/$service.release"
done < "$REMOTE_MANIFEST"
REMOTE_ARCHIVE="$upload/bundle.tar.gz"
# Use the manifest rather than a wildcard that could include the bundle itself.
set --
while IFS= read -r entry; do
    set -- "$@" "${entry%:*}.tar.gz" "${entry%:*}.release" "${entry%:*}.env"
done < "$REMOTE_MANIFEST"
tar -czf "$REMOTE_ARCHIVE" -C "$upload" "$@"
remote_each deploy
