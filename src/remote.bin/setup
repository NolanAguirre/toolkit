#!/bin/sh

: "${STATE_PATH:=${HOME:?HOME is not set}/.s6craft-tools}"
: "${GSTATE_PATH:=/var/lib/s6craft-tools}"
export STATE_PATH GSTATE_PATH
##<help>
## setup - Initialize local remote target state.
## Usage: toolkit setup remote
## Preserve targets; this does not contact a host.
##</help>
set -e
. "$(dirname "$0")/../lib/locking.sh"
: "${STATE_PATH:?STATE_PATH is not set}"
umask 077
mkdir -p "$STATE_PATH/remote"
file_lock "$STATE_PATH/remote/lock"
mkdir -p "$STATE_PATH/remote/targets" "$STATE_PATH/remote/history"
mkdir -p "$STATE_PATH/remote/connections"
mkdir -p "$STATE_PATH/remote/hosts"
mkdir -p "$STATE_PATH/remote/sync"
printf '%s\n' 'remote initialized'
