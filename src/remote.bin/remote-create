#!/bin/sh
##<help>
## create - Create the SSH target for a bootstrap repository.
## Usage: remote create <repo> <host-or-connection> [--user user] [--port port] [--identity-file path]
## Accept IP/DNS hosts, user@host and ssh://user@host:port. Use brackets for IPv6 with a port.
## Supply a user in the connection or --user. Port defaults to 22; options override connection values.
## Connect directly without SSH config. Default keys/agent are used if identity is omitted.
## Save connection settings locally; do not contact the host or store passwords/private keys.
##</help>
set -e
. "$REMOTE_BIN/../lib/files.sh"
if [ -e "$REMOTE_CONFIG" ] || [ -e "$REMOTE_STATE/targets/$REMOTE_REPO" ]; then
    echo 'error: target already exists; use remote edit' >&2
    exit 1
fi
atomic_write "$REMOTE_CONFIG" jq -n --arg host "$REMOTE_TARGET" --arg user "$REMOTE_USER" --arg port "$REMOTE_PORT" --arg identity "$REMOTE_IDENTITY" \
    '{host: $host, user: $user, port: ($port | tonumber), identityFile: (if $identity == "" then null else $identity end)}'
