#!/bin/sh
##<help>
## create - Add an SSH target to a bootstrap repository.
## Usage: remote create <repo> <host-or-connection> [--name target] [--user user] [--port port] [--identity-file path]
## Target name defaults to default; fail if that target already exists. A repo may have several targets.
## Accept IP/DNS hosts, user@host and ssh://user@host:port. Use brackets for IPv6 with a port.
## User defaults to the local account and port to 22; connection values and options override defaults.
## Connect directly without SSH config. Default keys/agent are used if identity is omitted.
## Save connection settings locally; do not contact the host or store passwords/private keys.
##</help>
set -e
. "$REMOTE_BIN/../lib/remote.sh"
. "$REMOTE_BIN/../lib/files.sh"
if [ -e "$REMOTE_CONFIG" ]; then
    remote_error "target $REMOTE_TARGET_NAME already exists; use remote edit"
fi
remote_connection_write
