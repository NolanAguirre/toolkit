#!/bin/sh
##<help>
## edit - Edit an SSH target of a bootstrap repository.
## Usage: remote edit <repo> <host-or-connection> [--name target] [--user user] [--port port] [--identity-file path]
## Target name defaults to default. Replace its settings, including legacy aliases, with a direct IP/DNS target.
## Accept user@host or ssh://user@host:port. Options override connection values; port defaults to 22.
## A bare host defaults to the local account as SSH user.
## Identity is an optional absolute path. SSH config is not used. Replace the complete JSON config.
## Save locally without contacting the host or storing passwords/private keys.
##</help>
set -e
. "$REMOTE_BIN/../lib/remote.sh"
. "$REMOTE_BIN/../lib/files.sh"
if [ ! -f "$REMOTE_CONFIG" ]; then
    remote_error "target $REMOTE_TARGET_NAME missing; use remote create"
fi
remote_connection_write
