#!/bin/sh
##<help>
## supervision - Register stable service directories with s6.
## Usage: remote setup supervision <repo>
## Link /var/service/<repo>-<service> to /var/service-dir/<repo>-<service>.
## Reuse a running scanner; otherwise start s6 through Linux systemd or FreeBSD rc.d/s6.
## Only the scanner uses the host boot manager; applications and logs use s6-supervise.
##</help>
require_directory /var/service-dir root 755
require_directory /var/service root 755
for entry in "$@"; do
    service_names "$entry"
    require_users
    require_layout
    [ -x "$base/run" ] && [ -x "$base/log/run" ] || fail "run remote setup service for $service first"
    require_file_target "$base/run"
    require_file_target "$base/log/run"
    scan_link="/var/service/$unit"
    if [ -L "$scan_link" ]; then
        [ "$(readlink "$scan_link")" = "$base" ] || fail "conflicting supervision link: $scan_link"
    elif [ -e "$scan_link" ]; then
        fail "conflicting supervision path: $scan_link"
    fi
done
start_scanner
for entry in "$@"; do
    service_names "$entry"
    scan_link="/var/service/$unit"
    if [ ! -L "$scan_link" ]; then
        ln -s "$base" "$scan_link"
    fi
done
"$scannerctl" -a /var/service || fail 'cannot request an s6 rescan of /var/service'
for entry in "$@"; do
    service_names "$entry"
    printf '%s\tsupervision-ready\t%s\n' "$service" "$base"
done
