#!/bin/sh
##<help>
## setup-deploy - Prepare this machine for an existing deployment user.
## Usage: sudo remote this setup-deploy <deploy-user>
## Standalone: sudo sh src/remote.bin/this/setup-deploy <deploy-user>
## Run after this install-dependencies; rerun explicitly to update the root runner.
## Add the user to the shared port group and preserve existing port allocations.
## PORT_STATE_GROUP defaults to the existing registry group, otherwise s6craft-tools.
## Do not initialize personal toolkit state; reconnect to apply group membership.
## Copy host steps to /usr/local/lib/toolkit-remote and supervise s6-sudod on /run/toolkit-remote/sudod.sock.
## The socket runs only users, directories, service, supervision, deploy, releases and status.
## Allow <deploy-user> through /etc/toolkit-remote/rules; previously allowed users stay.
##</help>
set -e
case "${1:-}" in
    --help|-h)
        sed -n '/^##<help>$/,/^##<\/help>$/ { /^##</d; s/^## //; p; }' "$0"
        exit 0
        ;;
esac
if [ "$#" -ne 1 ]; then
    echo 'usage: sudo remote this setup-deploy <deploy-user>' >&2
    exit 2
fi
if [ "$(id -u)" -ne 0 ]; then
    echo 'error: run this setup-deploy with sudo on the machine being prepared' >&2
    exit 1
fi
PATH="/usr/local/sbin:/usr/local/bin:$PATH"
export PATH
src=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P)
REMOTE_BIN="$src/remote.bin"
. "$src/lib/remote.sh"
. "$src/lib/remote-host.sh"
for tool in s6-setlock s6-ipcserver s6-ipcserver-access s6-sudod s6-svc s6-svok; do
    command -v "$tool" >/dev/null || fail 'install s6 first'
done
# Share the deploy lock so no runner reads host code mid-replacement.
if [ "${TOOLKIT_REMOTE_LOCKED:-}" != 1 ]; then
    [ ! -L /var/run/toolkit-remote.lock ] || fail 'host lock must not be a symlink'
    exec s6-setlock -d 9 /var/run/toolkit-remote.lock env TOOLKIT_REMOTE_LOCKED=1 sh "$0" "$@"
fi
user=$1
uid=$(id -u "$user" 2>/dev/null) || fail "unknown user: $user"
: "${GSTATE_PATH:=/var/lib/s6craft-tools}"
if [ -d "$GSTATE_PATH/ports" ]; then
    shared_group=$(file_group "$GSTATE_PATH/ports")
    if [ -n "${PORT_STATE_GROUP:-}" ] && [ "$PORT_STATE_GROUP" != "$shared_group" ]; then
        fail "existing port registry belongs to group $shared_group; preserve that group"
    fi
    PORT_STATE_GROUP=$shared_group
else
    : "${PORT_STATE_GROUP:=s6craft-tools}"
fi
export GSTATE_PATH PORT_STATE_GROUP
if ! getent group "$PORT_STATE_GROUP" >/dev/null; then
    case "$(uname -s)" in
        Linux)
            groupadd "$PORT_STATE_GROUP"
            ;;
        FreeBSD)
            pw groupadd -n "$PORT_STATE_GROUP"
            ;;
        *)
            fail 'setup-deploy requires Linux or FreeBSD'
            ;;
    esac
fi
case "$(uname -s)" in
    Linux)
        usermod -a -G "$PORT_STATE_GROUP" "$user"
        ;;
    FreeBSD)
        pw groupmod "$PORT_STATE_GROUP" -m "$user"
        ;;
    *)
        fail 'setup-deploy requires Linux or FreeBSD'
        ;;
esac
sh "$src/port.bin/setup" --shared-only
umask 022
root_group=$(id -gn root)
lib=/usr/local/lib/toolkit-remote
socket=/run/toolkit-remote/sudod.sock
# Unit names always contain a dash, so this name cannot collide with a repo service.
daemon=/var/service-dir/toolkit_remote

mkdir -p /usr/local/lib
stage=$(mktemp -d /usr/local/lib/.toolkit-remote.XXXXXX)
previous=
trap 'rm -rf "$stage" ${previous:+"$previous"}' 0
trap 'exit 1' HUP INT TERM
cp "$src/lib/remote-host.sh" "$stage/remote-host.sh"
for file in validate run $remote_host_steps; do
    cp "$src/remote.bin/.host/$file" "$stage/$file"
done
remote_host_version "$src" > "$stage/version"
chown -R "root:$root_group" "$stage"
chmod 644 "$stage"/*
chmod 755 "$stage" "$stage/run"
if [ -e "$lib" ] || [ -L "$lib" ]; then
    [ -d "$lib" ] && [ ! -L "$lib" ] || fail "refusing non-directory: $lib"
    previous=$(mktemp -d /usr/local/lib/.toolkit-remote-old.XXXXXX)
    mv "$lib" "$previous/lib"
fi
mv "$stage" "$lib"
printf 'host code installed\t%s\n' "$lib"

make_directory /etc/toolkit-remote root 755
make_directory /etc/toolkit-remote/rules root 755
make_directory /etc/toolkit-remote/rules/uid root 755
make_directory "/etc/toolkit-remote/rules/uid/$uid" root 755
atomic_to "/etc/toolkit-remote/rules/uid/$uid/allow" "root:$root_group" 644 true
printf 'runner allowed\t%s\n' "$user"

make_directory /var/service-dir root 755
make_directory /var/service root 755
make_directory "$daemon" root 755
run_content=$(cat <<RUN
#!/bin/sh
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH
mkdir -p ${socket%/*}
chmod 755 ${socket%/*}
rm -f $socket
# Any local user may connect; s6-ipcserver-access admits only uids under rules/uid.
umask 000
exec s6-ipcserver $socket s6-ipcserver-access -v0 -i /etc/toolkit-remote/rules s6-sudod -t 30000 $lib/run
RUN
)
changed=1
if [ -f "$daemon/run" ] && [ "$(cat "$daemon/run")" = "$run_content" ]; then
    changed=0
fi
atomic_to "$daemon/run" "root:$root_group" 755 printf '%s\n' "$run_content"
scan_link=/var/service/toolkit_remote
if [ -L "$scan_link" ]; then
    [ "$(readlink "$scan_link")" = "$daemon" ] || fail "conflicting supervision link: $scan_link"
elif [ -e "$scan_link" ]; then
    fail "conflicting supervision path: $scan_link"
else
    ln -s "$daemon" "$scan_link"
fi
start_scanner
"$scannerctl" -a /var/service || fail 'cannot request an s6 rescan of /var/service'
if [ "$changed" = 1 ] && s6-svok "$daemon" 2>/dev/null; then
    s6-svc -t "$daemon"
fi
attempt=0
until [ -S "$socket" ]; do
    [ "$attempt" -lt 10 ] || fail "runner socket did not appear within 10 seconds: $socket"
    sleep 1
    attempt=$((attempt + 1))
done
printf 'runner ready\t%s\n' "$socket"
printf 'Reconnect as %s to apply membership in %s.\n' "$user" "$PORT_STATE_GROUP"
