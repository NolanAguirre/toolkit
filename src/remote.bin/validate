#!/bin/sh

: "${STATE_PATH:=${HOME:?HOME is not set}/.s6craft-tools}"
: "${GSTATE_PATH:=/var/lib/s6craft-tools}"
export STATE_PATH GSTATE_PATH
set -e
REMOTE_BIN=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
# Local host preparation validates its own arguments, OS and root access.
case "$1" in
    */remote.bin/this/install-dependencies|*/remote.bin/this/setup-deploy|*/remote.bin/host/bootstrap|*/remote.bin/host/install)
        command=$1
        shift
        exec "$command" "$@"
        ;;
esac
. "$REMOTE_BIN/../lib/locking.sh"
. "$REMOTE_BIN/../lib/remote.sh"
: "${STATE_PATH:?STATE_PATH is not set}"
REMOTE_STATE="$STATE_PATH/remote"
[ -f "$REMOTE_STATE/lock" ] && [ -d "$REMOTE_STATE/targets" ] || remote_error 'run toolkit setup remote first'
umask 077
file_lock "$REMOTE_STATE/lock"
command=$1
shift
action=${command##*/}
registry=0
case "$command" in
    */host/*)
        registry=1
        action="remote-$action"
        ;;
esac
case "$command" in
    */sync/*)
        . "$REMOTE_BIN/.sync-validate"
        ;;
esac
command -v jq >/dev/null 2>&1 || remote_error 'jq is required for remote target configuration'
# Pull target selection out first so positional checks below stay unchanged.
REMOTE_TO=
REMOTE_TARGET_NAME=
to_given=0
name_given=0
if [ "$registry" = 0 ]; then
    count=$#
    while [ "$count" -gt 0 ]; do
        case "$1" in
            --to|--name)
                [ "$count" -ge 2 ] || remote_error "$1 requires a value"
                if [ "$1" = --to ]; then
                    case "$action" in
                        remote-rm|remote-deploy|remote-status|remote-releases|remote-setup) ;;
                        *) remote_error "--to is not supported by ${action#remote-}" ;;
                    esac
                    [ "$to_given" = 0 ] || remote_error '--to may be given once'
                    [ -n "$2" ] || remote_error '--to requires target names'
                    to_given=1
                    REMOTE_TO=$2
                else
                    case "$action" in
                        remote-create|remote-edit|remote-use) ;;
                        *) remote_error "--name is not supported by ${action#remote-}" ;;
                    esac
                    [ "$name_given" = 0 ] || remote_error '--name may be given once'
                    name_given=1
                    REMOTE_TARGET_NAME=$2
                fi
                shift 2
                count=$((count - 2))
                ;;
            *)
                set -- "$@" "$1"
                shift
                count=$((count - 1))
                ;;
        esac
    done
fi
case "$action" in
    remote-ls)
        [ "$#" -eq 0 ] || remote_error 'usage: remote ls'
        export REMOTE_STATE REMOTE_BIN
        exec "$command" "$@"
        ;;
    remote-install-toolkit)
        [ "$registry" = 1 ] && [ "$#" -eq 1 ] || remote_error 'usage: remote host install-toolkit <host-name>'
        ;;
    remote-create|remote-edit|remote-load)
        [ -d "$REMOTE_STATE/connections" ] || remote_error 'run toolkit setup remote to initialize JSON connection settings'
        [ "$#" -ge 2 ] || remote_error 'usage: remote create|edit <repo> <host-or-connection> [--name target] [--user user] [--port port] [--identity-file path]'
        repo=$1
        connection=$2
        REMOTE_TARGET=$connection
        REMOTE_USER=$(id -un)
        REMOTE_PORT=22
        REMOTE_IDENTITY=
        case "$REMOTE_TARGET" in
            ssh://*)
                REMOTE_TARGET=${REMOTE_TARGET#ssh://}
                REMOTE_TARGET=${REMOTE_TARGET%/}
                ;;
        esac
        case "$REMOTE_TARGET" in
            *@*)
                REMOTE_USER=${REMOTE_TARGET%%@*}
                REMOTE_TARGET=${REMOTE_TARGET#*@}
                ;;
        esac
        case "$REMOTE_TARGET" in
            \[*\]:*)
                REMOTE_PORT=${REMOTE_TARGET##*]:}
                REMOTE_TARGET=${REMOTE_TARGET%]:*}
                REMOTE_TARGET=${REMOTE_TARGET#\[}
                ;;
            \[*\])
                REMOTE_TARGET=${REMOTE_TARGET#\[}
                REMOTE_TARGET=${REMOTE_TARGET%\]}
                ;;
            *:*:*)
                # Unbracketed IPv6 has no port suffix.
                ;;
            *:*)
                REMOTE_PORT=${REMOTE_TARGET##*:}
                REMOTE_TARGET=${REMOTE_TARGET%:*}
                ;;
        esac
        shift 2
        while [ "$#" -gt 0 ]; do
            [ "$#" -ge 2 ] || remote_error 'connection options require a value'
            case "$1" in
                --user)
                    REMOTE_USER=$2
                    ;;
                --port)
                    REMOTE_PORT=$2
                    ;;
                --identity-file)
                    REMOTE_IDENTITY=$2
                    ;;
                *)
                    remote_error 'expected --user, --port or --identity-file'
                    ;;
            esac
            shift 2
        done
        set -- "$repo" "$connection"
        remote_connection_validate
        export REMOTE_TARGET REMOTE_USER REMOTE_PORT REMOTE_IDENTITY
        ;;
    remote-use)
        [ "$#" -eq 2 ] || remote_error 'usage: remote use <repo> <host-name> [--name target]'
        remote_token "$2" || remote_error 'invalid host name'
        [ "$name_given" = 1 ] || REMOTE_TARGET_NAME=$2
        ;;
    remote-rm|remote-status|remote-releases)
        [ "$#" -eq 1 ] || remote_error 'usage: remote rm|status|releases <repo> [--to target,...]'
        ;;
    remote-deploy)
        case "$#" in
            2) release_directory=$2 ;;
            3) release_directory=$3 ;;
            *) remote_error 'usage: remote deploy <repo> [service] <release-directory> [--to target,...]' ;;
        esac
        [ -d "$release_directory" ] && [ ! -L "$release_directory" ] || remote_error 'release must be a real directory'
        ;;
    remote-setup)
        [ "$#" -ge 2 ] || remote_error 'usage: remote setup <step> <repo> [service|--all] [--to target,...]'
        case "$1" in
            service)
                [ "$#" -eq 3 ] || remote_error 'usage: remote setup service <repo> <service|--all>'
                ;;
            users|directories|supervision|all)
                [ "$#" -eq 2 ] || remote_error 'unexpected setup arguments'
                ;;
            *)
                remote_error 'unknown setup step'
                ;;
        esac
        ;;
    *)
        remote_error 'unknown remote command'
        ;;
esac
if [ "$registry" = 1 ]; then
    [ -d "$REMOTE_STATE/hosts" ] || remote_error 'run toolkit setup remote to initialize the host registry'
    remote_token "$1" || remote_error 'invalid host name'
    REMOTE_CONFIG="$REMOTE_STATE/hosts/$1.json"
    export REMOTE_BIN REMOTE_STATE REMOTE_CONFIG
    exec "$command" "$@"
fi
if [ "$action" = remote-setup ]; then
    REMOTE_REPO=$2
else
    REMOTE_REPO=$1
fi
remote_token "$REMOTE_REPO" || remote_error 'repo must be a registered bootstrap name'
export REMOTE_BIN REMOTE_STATE REMOTE_REPO
case "$action" in
    remote-create|remote-edit|remote-use)
        [ -n "$REMOTE_TARGET_NAME" ] || REMOTE_TARGET_NAME=default
        remote_token "$REMOTE_TARGET_NAME" || remote_error 'invalid target name'
        REMOTE_CONFIG=$(remote_target_path "$REMOTE_TARGET_NAME")
        export REMOTE_CONFIG REMOTE_TARGET_NAME
        ;;
esac
# Removing a target must also work after its repository has been unregistered.
if [ "$action" = remote-rm ]; then
    export REMOTE_TO
    exec "$command" "$@"
fi
[ -f "$STATE_PATH/bootstrap/lock" ] || remote_error 'run toolkit setup bootstrap first'
exec 8>>"$STATE_PATH/bootstrap/lock"
flock -x 8
registration="$STATE_PATH/bootstrap/repos/$REMOTE_REPO/path"
[ -f "$registration" ] || remote_error 'repo is not registered; use bootstrap repo load or import'
root=$(cat "$registration")
[ -d "$root/services" ] && [ ! -L "$root/services" ] || remote_error 'registered repo needs a real services directory'
case "$action" in
    remote-create|remote-edit|remote-use)
        exec "$command" "$@"
        ;;
esac
REMOTE_MANIFEST=$(mktemp "$REMOTE_STATE/.services.XXXXXX")
REMOTE_TARGETS=
trap 'rm -f -- "$REMOTE_MANIFEST" ${REMOTE_TARGETS:+"$REMOTE_TARGETS"}' 0
trap 'exit 1' HUP INT TERM
REMOTE_TARGETS=$(mktemp "$REMOTE_STATE/.targets.XXXXXX")
# Every selected target must exist and load before any SSH.
remote_targets_select "$REMOTE_TO"
command -v ssh >/dev/null 2>&1 || remote_error 'ssh is required'
selected=--all
if [ "$action" = remote-setup ] && [ "$1" = service ]; then
    selected=$3
    [ "$selected" = --all ] || remote_token "$selected" || remote_error 'invalid service name'
fi
if [ "$action" = remote-deploy ] && [ "$#" -eq 3 ]; then
    selected=$2
    remote_token "$selected" || remote_error 'invalid service name'
fi
env_user=${ENV_USER:-${USER:-default}}
remote_token "$env_user" || remote_error 'ENV_USER must be a simple directory name'
for directory in "$root"/services/*; do
    [ -d "$directory" ] || continue
    [ ! -L "$directory" ] || remote_error "service symlinks are not supported: $directory"
    declarations="$directory/remote-services"
    explicit=0
    if [ -e "$declarations" ] || [ -L "$declarations" ]; then
        [ -f "$declarations" ] && [ ! -L "$declarations" ] || remote_error "remote-services must be a regular file: $declarations"
        explicit=1
    fi
    # Expand source folders into deployment identities before selecting one.
    if [ "$explicit" = 1 ]; then
        definitions=$(cat "$declarations")
    else
        definitions="${directory##*/}:PORT"
    fi
    printf '%s\n' "$definitions" | (
        count=0
        while IFS= read -r entry || [ -n "$entry" ]; do
            case "$entry" in
                ''|\#*)
                    continue
                    ;;
                *:*)
                    service=${entry%%:*}
                    port_key=${entry#*:}
                    ;;
                *)
                    remote_error "expected service:PORT_VARIABLE or service:- in $declarations"
                    ;;
            esac
            remote_token "$service" || remote_error "invalid service name: $service"
            unit="$REMOTE_REPO-$service"
            case "$unit" in
                [!a-z_]*|*[!a-z0-9_-]*)
                    remote_error 'remote repo and service names must form a lowercase Unix account name'
                    ;;
            esac
            [ "${#unit}" -le 27 ] || remote_error 'repo-service must be at most 27 characters (including the hyphen)'
            case "$port_key" in
                -)
                    ;;
                ''|[!A-Z_]*|*[!A-Z0-9_]*)
                    remote_error "invalid port variable for $service: $port_key"
                    ;;
            esac
            port=-
            if [ "$port_key" != - ]; then
                for environment in "$directory"/env-*; do
                    case "${environment##*/}" in
                        env-dir|env-dev)
                            ;;
                        *)
                            continue
                            ;;
                    esac
                    file="$environment/$env_user/$port_key"
                    [ -e "$file" ] || file="$environment/default/$port_key"
                    [ -e "$file" ] || continue
                    value=$(cat "$file")
                    [ -n "$value" ] || continue
                    [ "$port" = - ] || remote_error "multiple $port_key sources for $service"
                    case "$value" in
                        *[!0-9]*|'')
                            remote_error "invalid $port_key for $service"
                            ;;
                    esac
                    [ "${#value}" -le 5 ] && [ "$value" -ge 1 ] && [ "$value" -le 65535 ] || remote_error "invalid $port_key for $service"
                    port=$(printf '%s' "$value" | sed 's/^0*//')
                done
                if [ "$explicit" = 1 ] && [ "$port" = - ]; then
                    remote_error "missing $port_key for $service; use $service:- for a service without a port"
                fi
            fi
            printf '%s:%s\n' "$service" "$port"
            count=$((count + 1))
        done
        [ "$count" -gt 0 ] || remote_error "no services in $declarations"
    ) >> "$REMOTE_MANIFEST"
done
if ! awk -F: '{ if (seen[$1]++) exit 1 }' "$REMOTE_MANIFEST"; then
    remote_error 'services have duplicate deployment names'
fi
if ! awk -F: '$2 != "-" { if (seen[$2]++) exit 1 }' "$REMOTE_MANIFEST"; then
    remote_error 'services have duplicate ports'
fi
if [ "$selected" != --all ]; then
    entries=$(awk -F: -v selected="$selected" '$1 == selected' "$REMOTE_MANIFEST")
    [ -n "$entries" ] || remote_error 'no matching services in repository'
    printf '%s\n' "$entries" > "$REMOTE_MANIFEST"
fi
[ -s "$REMOTE_MANIFEST" ] || remote_error 'no matching services in repository'

export REMOTE_MANIFEST REMOTE_TARGETS
# Keep the locks and cleanup trap in this parent until SSH and all children exit.
"$command" "$@"
