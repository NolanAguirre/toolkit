#!/bin/sh

: "${STATE_PATH:=${HOME:?HOME is not set}/.s6craft-tools}"
: "${GSTATE_PATH:=/var/lib/s6craft-tools}"
export STATE_PATH GSTATE_PATH
set -e
. "$(dirname "$0")/../lib/locking.sh"
# Command history belongs to the user's encryption key, not the shared registry.
export HISTORY_DIR="$STATE_PATH/ports/history"
case "$(basename "$1")" in
    port-history)
        exec "$@"
        ;;
esac
export STATE_DIR="$GSTATE_PATH/ports"
if [ ! -f "$STATE_DIR/lock" ] || [ ! -f "$STATE_DIR/allocate/ports" ]; then
    echo "error: port is not initialized; run toolkit setup port" >&2
    exit 1
fi
umask 077
# The inherited descriptor holds the lock through exec. The kernel releases it
# when the command exits, including on failure or termination; no stale lock.
if [ ! -w "$STATE_DIR/lock" ] || [ ! -w "$STATE_DIR/allocate/ports" ]; then
    echo "error: port state requires membership in its shared group; ask an administrator for access" >&2
    exit 1
fi
file_lock "$STATE_DIR/lock"
export ATOMIC_WRITE_MODE=660
command -v jq >/dev/null || { echo "error: port requires jq" >&2; exit 1; }
# Refuse corrupt or duplicate reservations rather than risk allocating twice.
jq -se '
    all(.[];
        (.port | type == "number") and (.port >= 1 and .port <= 65535) and
        (.port == (.port | floor)) and
        (.domain | test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) and (.domain != "ports"))
    and ((map(.port) | unique | length) == length)
' "$STATE_DIR/allocate/ports" >/dev/null || {
    echo "error: invalid or duplicate allocation in port index" >&2
    exit 1
}
exec "$@"
