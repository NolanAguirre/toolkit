#!/bin/sh
##<help>
## import - Register and select an existing repository and discover its service ports.
## Usage: bootstrap repo import <path> [--copy-rules]
## Accept absolute or relative paths, including . and ..; store and print the absolute path.
## Require a services directory; use the canonical directory basename as the name.
## Preserve repository files and reuse existing port domains and reservations.
## Add missing CLAUDE.md, CODEX.md, .cursorignore, .cursorrules, Claude rule and Cursor rule/skill
## links from ~/.s6craft. Link each ~/.s6craft/<dir>/CODEX.md when the repository has <dir>.
## --copy-rules copies rule files, including scoped CODEX.md, .cursorrules and .cursorignore.
## Copies can be edited locally; existing files/links are preserved and skills remain linked.
## Add project_doc_fallback_filenames = ["CODEX.md"] to ${CODEX_HOME:-~/.codex}/config.toml if missing.
## Require the same shared rules as repo create. Never replace existing files or links.
## Re-import to pick up new shared rules and skills. Cursor and Claude parent directories must be
## real directories.
## Read env-dir/env-dev PORT files using ENV_USER (or USER), then default.
## Create a 100-port domain if missing. Services without PORT files need no reservation.
## Reject conflicting registrations or ports. Print the imported repository path.
## Completed port reservations remain available for retry if registration fails.
##</help>
set -e
. "$(dirname "$0")/../../lib/bootstrap.sh"
if [ "$#" -lt 1 ]; then
    bootstrap_error 'usage: bootstrap repo import <path> [--copy-rules]'
fi
if [ ! -d "$1" ]; then
    bootstrap_error "repo directory does not exist: $1"
fi
path=$(CDPATH= cd -- "$1" && pwd -P)
shift
rules_mode=link
while [ "$#" -gt 0 ]; do
    case "$1" in
        --copy-rules)
            rules_mode=copy
            shift
            ;;
        *)
            bootstrap_error "unknown option: $1"
            ;;
    esac
done
if [ "$path" != "$(printf '%s' "$path" | tr '\t\n' '  ')" ]; then
    bootstrap_error 'repo paths cannot contain tabs or newlines'
fi
name=${path##*/}
bootstrap_name "$name"
if [ ! -d "$path/services" ] || [ -L "$path/services" ]; then
    bootstrap_error 'repo pattern requires a services directory (not a symlink)'
fi
rules_dir="$HOME/.s6craft"
if [ ! -d "$rules_dir/.cursor/rules" ] || [ ! -d "$rules_dir/.claude/rules" ] || [ ! -f "$rules_dir/CLAUDE.md" ] || [ ! -f "$rules_dir/CODEX.md" ] || [ ! -f "$rules_dir/.cursorignore" ] || [ ! -f "$rules_dir/.cursorrules" ]; then
    bootstrap_error "missing shared rules in $rules_dir"
fi
if [ -L "$path/.cursor" ] || { [ -e "$path/.cursor" ] && [ ! -d "$path/.cursor" ]; }; then
    bootstrap_error '.cursor must be a real directory'
fi
if [ -L "$path/.cursor/rules" ] || { [ -e "$path/.cursor/rules" ] && [ ! -d "$path/.cursor/rules" ]; }; then
    bootstrap_error '.cursor/rules must be a real directory'
fi
if [ -L "$path/.cursor/skills" ] || { [ -e "$path/.cursor/skills" ] && [ ! -d "$path/.cursor/skills" ]; }; then
    bootstrap_error '.cursor/skills must be a real directory'
fi
if [ -L "$path/.claude" ] || { [ -e "$path/.claude" ] && [ ! -d "$path/.claude" ]; }; then
    bootstrap_error '.claude must be a real directory'
fi
if [ -L "$path/.claude/rules" ] || { [ -e "$path/.claude/rules" ] && [ ! -d "$path/.claude/rules" ]; }; then
    bootstrap_error '.claude/rules must be a real directory'
fi
# Check registry conflicts before changing any port state.
if [ -e "$STATE_DIR/repos/$name" ]; then
    if [ "$(cat "$STATE_DIR/repos/$name/path")" != "$path" ]; then
        bootstrap_error "repo name already registered: $name"
    fi
fi
for existing in "$STATE_DIR"/repos/*/path; do
    [ -f "$existing" ] || continue
    if [ "$(cat "$existing")" = "$path" ] && [ "$existing" != "$STATE_DIR/repos/$name/path" ]; then
        bootstrap_error "path already registered: $path"
    fi
done
command -v port >/dev/null 2>&1 || bootstrap_error 'port command is required'
bootstrap_codex_config
# Domain creation and discovery share the port lock; our parent holds bootstrap's.
(cd -- "$path" && port allocate discover --create-domain) >&2
mkdir -p -- "$path/.cursor/rules" "$path/.cursor/skills" "$path/.claude/rules"
for rule in "$rules_dir"/.cursor/rules/*.mdc; do
    [ -f "$rule" ] || continue
    bootstrap_install_missing "$rule" "$path/.cursor/rules/${rule##*/}" "$rules_mode"
done
for rule in "$rules_dir"/.claude/rules/*.md; do
    [ -f "$rule" ] || continue
    bootstrap_install_missing "$rule" "$path/.claude/rules/${rule##*/}" "$rules_mode"
done
bootstrap_install_missing "$rules_dir/CLAUDE.md" "$path/CLAUDE.md" "$rules_mode"
bootstrap_install_missing "$rules_dir/CODEX.md" "$path/CODEX.md" "$rules_mode"
for codex in "$rules_dir"/*/CODEX.md; do
    [ -f "$codex" ] || continue
    dir=${codex%/CODEX.md}
    dir=${dir##*/}
    [ -d "$path/$dir" ] || continue
    bootstrap_install_missing "$codex" "$path/$dir/CODEX.md" "$rules_mode"
done
bootstrap_install_missing "$rules_dir/.cursorignore" "$path/.cursorignore" "$rules_mode"
bootstrap_install_missing "$rules_dir/.cursorrules" "$path/.cursorrules" "$rules_mode"
for skill in "$rules_dir"/.cursor/skills/*; do
    [ -d "$skill" ] && [ -f "$skill/SKILL.md" ] || continue
    bootstrap_install_missing "$skill" "$path/.cursor/skills/${skill##*/}"
done
bootstrap_register "$name" "$path"
