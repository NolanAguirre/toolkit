#!/bin/sh
##<help>
## ls - List supported service types and their configuration.
## Usage: bootstrap service type ls
## Print TSV with a header: type, label, options, required, description.
## Options and required are comma-separated; - means none. Required options are automatic.
## Optional support is off by default in the CLI. The dashboard initially selects HTTP.
## Node ML is Node.js plus the required Python ML consumer scaffold.
##</help>
set -e
if [ "$#" -ne 0 ]; then
    echo 'error: usage: bootstrap service type ls' >&2
    exit 1
fi
cat <<'TYPES'
type	label	options	required	description
nodejs	Node.js	http,fs,db	-	Creates the Node.js package and environment files. Add application code before starting it.
node-ml	Node ML (Node.js + Python)	http,fs,db,python	python	Creates the Node.js package, Python consumer, filesystem queue helpers and environment files. Add application and ML code before starting it.
TYPES
