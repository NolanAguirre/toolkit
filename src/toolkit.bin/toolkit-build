#!/bin/sh

##<help>
## build - Copy source tools into the configured bin directory.
## Usage: toolkit build
## Copy tools and shared helpers from the configured source to the bin directory.
## Replace installed copies and make scripts executable; preserve toolkit state.
## Files removed from source remain installed until toolkit prune is run.
##</help>

set -e

umask 022
. "$(dirname "$0")/../lib/files.sh"
: "${GLOBAL_STATE_DIR:=$GSTATE_PATH/toolkit}"
manifest="$GLOBAL_STATE_DIR/installed"

mkdir -p "$TOOLKIT_BIN_PATH"

# Refuse to claim existing files that were not installed by this toolkit.
for source in "$TOOLKIT_SRC_PATH"/* "$TOOLKIT_SRC_PATH"/.[!.]* "$TOOLKIT_SRC_PATH"/..?*; do
    [ -e "$source" ] || [ -L "$source" ] || continue
    name=$(basename "$source")
    if [ -e "$TOOLKIT_BIN_PATH/$name" ] || [ -L "$TOOLKIT_BIN_PATH/$name" ]; then
        if ! grep -Fxq -- "$name" "$manifest"; then
            echo "error: refusing to overwrite unmanaged path: $TOOLKIT_BIN_PATH/$name" >&2
            exit 1
        fi
    fi
done

for source in "$TOOLKIT_SRC_PATH"/* "$TOOLKIT_SRC_PATH"/.[!.]* "$TOOLKIT_SRC_PATH"/..?*; do
    [ -e "$source" ] || [ -L "$source" ] || continue
    name=$(basename "$source")

    # Record ownership before copying so interrupted installs remain recoverable.
    if ! grep -Fxq -- "$name" "$manifest"; then
        atomic_write "$manifest" sh -c 'cat "$1" && printf "%s\n" "$2"' sh "$manifest" "$name"
    fi

    # Replace files so running scripts can finish reading their original copies.
    if [ -L "$source" ]; then
        cp --remove-destination -P "$source" "$TOOLKIT_BIN_PATH/"
    elif [ -d "$source" ]; then
        cp --remove-destination -r "$source" "$TOOLKIT_BIN_PATH/"
        find "$TOOLKIT_BIN_PATH/$name" -type d -exec chmod a+rx {} +
        find "$TOOLKIT_BIN_PATH/$name" -type f -exec chmod a+rx {} +
    elif [ -f "$source" ]; then
        cp --remove-destination -r "$source" "$TOOLKIT_BIN_PATH/"
        chmod a+rx "$TOOLKIT_BIN_PATH/$name"
    fi
done

echo "toolkit built"
