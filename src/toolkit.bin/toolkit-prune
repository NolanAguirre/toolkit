#!/bin/sh

##<help>
## prune - Remove installed files absent from source; -n previews removals.
## Usage: toolkit prune [-n]
## Compare toolkit-owned paths with source, including nested directories.
## Leave unrelated entries in the shared bin directory alone.
## Without -n, delete installed entries with no matching source path.
## Source files and state under STATE_PATH are unchanged.
##</help>

set -e

dry_run=false
if [ "${1:-}" = "-n" ]; then
    dry_run=true
fi

prune_dir() (
    source="$1"
    destination="$2"
    prefix="$3"

    for entry in "$destination"/*; do
        if [ ! -e "$entry" ] && [ ! -L "$entry" ]; then
            continue
        fi

        name="$(basename "$entry")"
        relative_path="${prefix}${name}"

        if [ ! -e "$source/$name" ] && [ ! -L "$source/$name" ]; then
            if [ "$dry_run" = true ]; then
                echo "would remove: $relative_path"
            else
                rm -rf "$entry"
                echo "removed: $relative_path"
            fi
        elif [ -d "$entry" ] && [ ! -L "$entry" ] && [ -d "$source/$name" ] && [ ! -L "$source/$name" ]; then
            prune_dir "$source/$name" "$entry" "$relative_path/"
        fi
    done
)

manifest="$GLOBAL_STATE_DIR/installed"
if [ ! -f "$manifest" ]; then
    echo "error: installation manifest not found; run toolkit build first" >&2
    exit 1
fi

output=$(
    while IFS= read -r name; do
        case "$name" in
            ''|.|..|*/*)
                echo "error: invalid installation manifest entry" >&2
                exit 1
                ;;
        esac
        source="$TOOLKIT_SRC_PATH/$name"
        destination="$TOOLKIT_BIN_PATH/$name"
        if [ ! -e "$destination" ] && [ ! -L "$destination" ]; then
            continue
        fi
        if [ ! -e "$source" ] && [ ! -L "$source" ]; then
            if [ "$dry_run" = true ]; then
                echo "would remove: $name"
            else
                rm -rf -- "$destination"
                echo "removed: $name"
            fi
        elif [ -d "$source" ] && [ ! -L "$source" ] && [ -d "$destination" ] && [ ! -L "$destination" ]; then
            prune_dir "$source" "$destination" "$name/"
        fi
    done < "$manifest"
)

if [ -z "$output" ]; then
    echo "nothing to prune"
else
    echo "$output"
    removed=$(echo "$output" | wc -l | tr -d ' ')

    if [ "$dry_run" = true ]; then
        echo "$removed item(s) would be removed"
    else
        echo "$removed item(s) removed"
    fi
fi
